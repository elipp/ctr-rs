{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "scripts/uv-run.sh *"
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch --list*)",
      "Bash(git rev-parse*)",
      "Bash(wc *)",
      "Bash(readelf *)",
      "Bash(objdump *)",
      "Bash(nm *)",
      "Bash(scripts/uv-run.sh)",
      "Bash(scripts/uv-run.sh *)"
    ],
    "ask": [
      "Bash(rg *)",
      "Bash(find *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(./scripts/**)",
      "Edit(./.claude/**)",
      "Edit(./.git/**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(node *)",
      "Bash(perl *)",
      "Bash(ruby *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git clean*)"
    ]
  }
}